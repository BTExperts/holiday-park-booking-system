{
  "name": "holiday-park-booking-system",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Holiday park booking management system with React frontend and Node.js backend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd server && npm run dev",
    "server:start": "cd server && npm start",
    "migrate": "cd server && node migrate.js",
    "backup": "cd server && node migrate.js export",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "import-demo": "node import-demo-data.js",
    "remove-demo": "node remove-demo-data.js",
    "reset-test": "node reset-for-testing.js",
    "setup": "node scripts/setup.js",
    "clean": "rm -rf dist node_modules server/node_modules",
    "install:all": "npm install && cd server && npm install",
    "lint": "echo 'No linting configured yet'",
    "test": "echo 'No tests configured yet'"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  },
  "keywords": [
    "holiday-park",
    "booking-system",
    "react",
    "sqlite",
    "nodejs"
  ],
  "author": "Holiday Park Booking System",
  "license": "UNLICENSED"
}
